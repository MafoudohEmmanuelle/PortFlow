# backend/.env.example
# ============================================================
# EXEMPLE DE CONFIGURATION - À COPIER VERS .env
# ============================================================

# APPLICATION
APP_NAME=your_app_name example: PortFlow
API_V1_PREFIX=/api/v1
DEBUG=false

# BASE DE DONNÉES
DATABASE_URL=you can use either DATABASE_URL or the following individual settings
DB_HOST=your_database_host example: localhost
DB_USER=your_database_user example: portflow
DB_PASSWORD=CHANGE_ME
DB_NAME=your_database_name example: portflow
DB_PORT=5432

# JWT
SECRET_KEY=CHANGE_ME_GENERATE_RANDOM
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
